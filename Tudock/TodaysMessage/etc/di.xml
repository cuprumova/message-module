    <type name="Tudock\TodaysMessage\Model\ResourceModel\Message\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">tudock_todaysmessage_message</argument>
            <argument name="eventPrefix" xsi:type="string">tudock_todaysmessage_image_records_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">tudock_todaysmessage_image_grid_records_collection</argument>
            <argument name="resourceModel" xsi:type="string">Tudock\TodaysMessage\Model\ResourceModel\Message</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <!--data provider name which used in grid ui component file -->
                <item name="tudock_todaysmessage_message_listing_data_source" xsi:type="string">Tudock\TodaysMessage\Model\ResourceModel\Message\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <preference for="Tudock\TodaysMessage\Api\Data\MessageSearchResultsInterface" type="Tudock\TodaysMessage\Model\MessageSearchResults" />


</config>
